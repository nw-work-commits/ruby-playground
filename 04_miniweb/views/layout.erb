<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>TODO・日程表</title>
  <link rel="icon" href="<%= url("/favicon.svg") %>" type="image/svg+xml">
  <link rel="stylesheet" href="<%= url("/style.css") %>">
</head>
<body>
  <main>
    <% %w[notice warning error].each do |kind| -%>
      <% if flash[kind] -%>
        <div class="flash <%= kind %>" role="status"><%= h flash[kind] %></div>
      <% end -%>
    <% end -%>
    <%= yield %>
  </main>
</body>
</html>
