<% unless request.env["SCRIPT_NAME"].to_s.empty? -%>
  <p class="back"><a href="/">← Ruby Playground</a></p>
<% end -%>
<div class="head">
  <div>
    <h1><img src="<%= url("/favicon.svg") %>" alt=""> TODO・日程表</h1>
    <% if MiniWeb::IN_BROWSER -%>
    <p class="sub">自作フレームワークで動いています（ブラウザの中の Ruby が実行中）</p>
    <% else -%>
    <p class="sub">自作フレームワーク + 自作 HTTP サーバーで動いています</p>
    <% end -%>
  </div>
  <nav class="views" aria-label="表示切り替え">
    <a href="<%= url("/") %>" class="<%= 'on' unless @monday %>">リスト</a>
    <a href="<%= url("/week") %>" class="<%= 'on' if @monday %>">週</a>
  </nav>
</div>
